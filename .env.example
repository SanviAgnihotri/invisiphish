# ---------------------------------------------------------------------------
# InvisiPhish environment configuration
#
# Copy to `.env.local` for local development. Everything here is read on the
# SERVER. There is deliberately no `VITE_*` variable: the browser talks only
# to the API routes and never receives a database URL or an API key.
#
#   .env.local          local development (gitignored)
#   Vercel / host env   production
# ---------------------------------------------------------------------------

# --- Neon (Postgres) -------------------------------------------------------
#
# DATABASE_URL connects the application role. It must NOT have the BYPASSRLS
# attribute, because Row Level Security is what limits what a user can read.
#
# DATABASE_ADMIN_URL connects the owner role, which does have BYPASSRLS.
# Use it for migrations and background jobs only, never to serve a request
# that carries user data.
#
# Both are in the Neon console under "Connection strings".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.neon.tech/neondb?sslmode=require
DATABASE_ADMIN_URL=postgresql://OWNER:PASSWORD@ep-xxx.region.neon.tech/neondb?sslmode=require

# --- Neon Auth -------------------------------------------------------------
#
# The Managed Better Auth URL from the Neon console. Users, sessions and
# credentials live in the `neon_auth` schema of the same database.
NEON_AUTH_BASE_URL=https://YOUR-AUTH-ENDPOINT

# --- Generative explanation layer -----------------------------------------
#
# Server-side only. This key is never sent to the browser.
# Without it the explanation layer falls back to a deterministic summary that
# is still fully grounded, so the system keeps working.
#
# OpenCode Go serves an OpenAI-compatible API at
# https://opencode.ai/inference/go/openai/v1. The key comes from the OpenCode
# console (https://opencode.ai/console) and is the same one used by the
# OpenCode client. Go requires two things the raw HTTP API does not mention:
# a stable `x-opencode-session` header and a client-identifying user agent;
# both are sent by `api/_lib/explain.ts`.
OPENCODE_API_KEY=

# The models the explanation layer tries, in order. The first one that
# answers is used; the rest are backups for when the service refuses a
# request or a model answers in prose instead of in the schema.
#
# They were picked by measuring every model the endpoint offers against the
# real request: `minimax-m3`, `glm-5.2` and `glm-5.3` answered in prose every
# time, `deepseek-v4.1-flash` and `kimi-k2.7-code` refused the request, and
# the ones kept all return the object the schema asks for. They are long-lived
# models on a monthly plan, not the ones marked "preview" or "free".
OPENCODE_MODELS=glm-5.3-flash,mimo-v2.6-flash,qwen3.8-flash,mimo-v2.5,hy3,longcat-2.0

# The model to start with. It is prepended to the chain above.
OPENCODE_MODEL=glm-5.3-flash

OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Which provider generates the explanation: `opencode` or `gemini`.
EXPLAIN_PROVIDER=opencode

# The original provider, kept as an alternative. It is not used while
# EXPLAIN_PROVIDER is `opencode`.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Google sign-in -------------------------------------------------------
#
# There is nothing to configure here.
#
# The Google credentials belong to the Auth service, not to this application.
# Neon enables Google with shared credentials by default, so the button works
# on a fresh checkout. To sign in as your own application - so that users see
# your name on Google's consent screen rather than Neon's - create a Google
# OAuth client and give it to the Auth service: Neon console -> project ->
# branch -> Settings -> Auth -> OAuth providers -> Add -> Google.
#
# The sign-in runs in the browser, because the Auth service's OAuth state is
# held in cookies on the Auth service's own domain. What comes back is a
# session token, a JWT the Auth service signs, and this application's API
# checks that signature against the service's published key.

# --- Semantic model --------------------------------------------------------
#
# Where the exported DistilBERT checkpoint lives on the server. In local
# development this is the repository's public/models directory.
MODEL_DIR=./public/models/
